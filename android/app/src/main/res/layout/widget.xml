<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background" android:layout_width="match_parent" android:layout_height="match_parent">
 <TextView android:id="@+id/title" android:textSize="12sp" android:textStyle="bold" android:textColor="#DCE8F5" android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <ImageView android:id="@+id/chart" android:contentDescription="우공이산 모델, TQQQ, 버크셔 B 동일 기간 수익률 비교" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitXY"/>
 <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:id="@+id/account" android:text="우공 —" android:textSize="11sp" android:textStyle="bold" android:textColor="#75DFC5" android:maxLines="1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/weights" android:text="TQQQ —" android:textSize="11sp" android:textColor="#8CAAFF" android:maxLines="1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  <TextView android:id="@+id/loan" android:text="버크셔 —" android:textSize="11sp" android:textColor="#E5BB70" android:maxLines="1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
 </LinearLayout>
 <TextView android:id="@+id/state" android:textSize="9sp" android:textColor="#A2B5C9" android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>

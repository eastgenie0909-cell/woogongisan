<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="26dp">
 <TextView android:id="@+id/title" android:text="우공이산" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
 <TextView android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="10sp" android:id="@+id/period" android:text="1개월 ↻" android:gravity="center" android:textSize="10sp" android:textColor="@color/widget_chip_text" android:background="@drawable/widget_chip" android:maxLines="1" android:includeFontPadding="false" android:layout_width="60dp" android:layout_height="26dp" android:contentDescription="비교 기간 변경"/>
 </LinearLayout>
 <ImageView android:id="@+id/chart" android:contentDescription="우공이산 모델, TQQQ, 버크셔 B 동일 기간 수익률 비교" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginVertical="4dp" android:scaleType="fitXY"/>
 <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingEnd="4dp">
  <TextView android:text="우공 모델" android:textSize="9sp" android:textColor="@color/widget_model" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="14dp"/>
  <TextView android:id="@+id/account" android:text="—" android:textStyle="bold" android:textColor="@color/widget_model" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" android:layout_width="match_parent" android:layout_height="24dp"/>
 </LinearLayout><LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingEnd="4dp">
  <TextView android:text="TQQQ" android:textSize="9sp" android:textColor="@color/widget_tqqq" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="14dp"/>
  <TextView android:id="@+id/weights" android:text="—" android:textStyle="bold" android:textColor="@color/widget_tqqq" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" android:layout_width="match_parent" android:layout_height="24dp"/>
 </LinearLayout><LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingEnd="4dp">
  <TextView android:text="버크셔 B" android:textSize="9sp" android:textColor="@color/widget_brkb" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_width="match_parent" android:layout_height="14dp"/>
  <TextView android:id="@+id/loan" android:text="—" android:textStyle="bold" android:textColor="@color/widget_brkb" android:maxLines="1" android:includeFontPadding="false" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8dp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" android:layout_width="match_parent" android:layout_height="24dp"/>
 </LinearLayout></LinearLayout>

 <TextView android:id="@+id/state" android:textSize="8sp" android:textColor="@color/widget_muted" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:paddingTop="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
